{
  "name": "means-of-prediction-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run sync && vite",
    "build": "npm run sync && tsc -b && vite build",
    "preview": "vite preview",
    "sync": "node scripts/sync-contracts.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "dkim:sign-fixtures": "node scripts/sign-fixtures.mjs",
    "dkim:keys": "node scripts/dkim-keys.mjs",
    "sync:gnosis": "DEPLOYMENT=gnosis node scripts/sync-contracts.mjs",
    "build:gnosis": "DEPLOYMENT=gnosis node scripts/sync-contracts.mjs && tsc -b && vite build",
    "research:daily": "node --experimental-strip-types scripts/research/daily.mjs",
    "research:nyt": "node --experimental-strip-types scripts/research/sync-nyt.mjs",
    "research:nyt-candidates": "node --experimental-strip-types scripts/research/nyt-candidates.mjs",
    "research:nyt-rule": "python3 scripts/research/blind/generate_rule.py",
    "test:scripts": "node --experimental-strip-types --test scripts/research/*.test.mjs",
    "mailbox:setup": "node scripts/setup-mailbox.mjs",
    "test:body": "node --experimental-strip-types --test scripts/body.test.mjs",
    "e2e:body": "node --experimental-strip-types scripts/body-e2e.mjs",
    "test:automation": "node --experimental-strip-types --test automation/tests/*.test.mjs",
    "settler:run": "node --experimental-strip-types automation/run.mjs",
    "e2e:automation": "node --experimental-strip-types automation/e2e.mjs"
  },
  "dependencies": {
    "@breadcoop/ui": "^2.0.4",
    "@mlc-ai/web-llm": "0.2.84",
    "@phosphor-icons/react": "^2.1.7",
    "@tanstack/react-query": "^5.62.0",
    "imapflow": "1.7.2",
    "mailauth": "^5.0.2",
    "mailparser": "^3.9.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "stream-json": "^3.6.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.1"
  }
}
