[Unit]
Description=Means of Prediction restricted settlement signer
After=local-fs.target
[Service]
Type=simple
User=mop-signer
Group=mop-ipc
WorkingDirectory=/opt/mop/current/app
Environment=NODE_ENV=production
Environment=MOP_SIGNER_CONFIG=/etc/mop/signer/config.json
ExecStart=/usr/bin/flock --nonblock --no-fork /var/lib/mop-signer/process.lock /bin/sh -c 'rm -f /run/mop-ipc/signer.sock; exec /usr/local/bin/node --experimental-strip-types automation/run-signer.mjs'
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
UMask=0077
RuntimeDirectory=mop-ipc
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=yes
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/mop-signer
MemoryMax=220M
TasksMax=32
[Install]
WantedBy=multi-user.target
